{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sim Dao: ตรวจบัคเร็ว",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\run_audit.ps1", "-Mode", "Quick"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": ["$python"],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    },
    {
      "label": "Sim Dao: ตรวจบัคเต็มระบบ",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\tools\\run_audit.ps1", "-Mode", "Full"],
      "group": "test",
      "problemMatcher": ["$python"],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    },
    {
      "label": "Sim Dao: ศูนย์ควบคุมผู้มีจิตใจและนิยาย",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\Start-Minds.ps1", "-Paused", "-Count", "9", "-OutDir", "out\\minds-compare-6"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    }
  ]
}
